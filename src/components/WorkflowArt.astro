---
import Icon from './Icon.astro'
interface Props {
  kind: 'configure' | 'secure' | 'deploy'
  label: string
}
const { kind, label } = Astro.props
---

<div class:list={['workflow-art', `art-${kind}`]} role='img' aria-label={label}>
  <div aria-hidden='true'>
    {kind === 'configure' && (
      <>
        <div class='file-sheet sheet-back'>
          <span>CloudflareTunnel</span>
          <i />
          <i />
          <i />
        </div>
        <div class='file-sheet sheet-front'>
          <div class='file-heading'>
            <span class='file-dot' /> route.yaml <span>YAML</span>
          </div>
          <div class='mini-code'>
            <span>
              kind: <b>HTTPRoute</b>
            </span>
            <span>spec:</span>
            <span>&nbsp; hostnames:</span>
            <span>
              &nbsp; &nbsp; - <em>app.example.com</em>
            </span>
          </div>
          <span class='file-corner'>
            <Icon name='check' />
          </span>
        </div>
      </>
    )}
    {kind === 'secure' && (
      <>
        <div class='security-orbit orbit-outer' />
        <div class='security-orbit orbit-inner' />
        <div class='shield-emblem'>
          <Icon name='shield' />
        </div>
        <span class='policy-chip chip-one'>
          <span class='chip-dot' /> identity
        </span>
        <span class='policy-chip chip-two'>
          <span class='chip-dot' /> policy
        </span>
        <span class='security-caption'>Cloudflare Access</span>
      </>
    )}
    {kind === 'deploy' && (
      <>
        {/* Percentage coordinates share the node anchors in global.css. */}
        <svg class='connection-lines' viewBox='0 0 100 100' preserveAspectRatio='none' fill='none'>
          <path class='connection-path' d='M15 70 H38 Q50 70 50 54 V40 Q50 29 62 29 H85' />
          <path
            class='connection-path connection-return'
            d='M85 29 H91 Q97 29 97 41 V69 Q97 80 89 80 H15 V70'
          />
        </svg>
        <div class='network-node node-cluster'>
          <Icon name='stack' />
          <span>Kubernetes</span>
        </div>
        <div class='network-node node-cloud'>
          <Icon name='cloud' />
          <span>Cloudflare</span>
        </div>
        <div class='sync-chip'>
          <Icon name='check' /> cfgate
        </div>
      </>
    )}
  </div>
</div>
