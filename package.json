{
  "name": "cfgate-website",
  "version": "0.3.1",
  "description": "cfgate website, released documentation and project APIs",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "astro dev",
    "build": "tsx scripts/site/build.ts",
    "preview": "astro preview",
    "check": "astro check",
    "format": "prettier --write .",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "deploy": "tsx scripts/site/publish.ts",
    "types": "wrangler types src/worker-configuration.d.ts",
    "typecheck": "pnpm types && astro check && tsc --noEmit",
    "test": "vitest run && vitest run --config vitest.docs.config.ts",
    "test:watch": "vitest",
    "tail": "wrangler tail",
    "prepare": "pnpm types",
    "docs:prepare": "tsx scripts/docs/prepare.ts",
    "docs:build": "astro build --root docs",
    "docs:dev": "pnpm docs:prepare && astro dev --root docs",
    "test:docs": "vitest run --config vitest.docs.config.ts",
    "setup": "tsx scripts/site/setup.ts"
  },
  "author": "inherent.design",
  "license": "Apache-2.0",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": "^24.16.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/ts-plugin": "^1.10.12",
    "@cloudflare/vitest-plugin": "^1.3.6",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.19.1",
    "@types/sanitize-html": "^2.16.2",
    "@types/semver": "^7.8.0",
    "@vitest/runner": "^4.1.11",
    "@vitest/snapshot": "^4.1.11",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^10.12.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-cflint": "^1.0.0",
    "globals": "^17.13.0",
    "jiti": "^2.7.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.147.0"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/starlight": "0.42.5",
    "@inherent.design/brand": "^0.4.1",
    "@tabler/icons": "^3.48.0",
    "@tailwindcss/forms": "^0.5.11",
    "animejs": "4.5.0",
    "astro": "7.3.5",
    "github-slugger": "^2.0.0",
    "hono": "^4.13.12",
    "mdast-util-to-string": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "sanitize-html": "^2.18.0",
    "semver": "^7.8.5",
    "starlight-github-alerts": "0.5.0",
    "starlight-links-validator": "0.26.0",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tw-animate-css": "^1.4.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "private": true
}
