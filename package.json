{
  "name": "cfgate-infra",
  "version": "0.3.1",
  "description": "https://cfgate.io",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "format": "prettier --write .",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "deploy": "pnpm build && wrangler deploy",
    "types": "wrangler types src/worker-configuration.d.ts",
    "typecheck": "pnpm types && astro check && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "tail": "wrangler tail",
    "tail:prod": "wrangler tail --env production",
    "prepare": "pnpm types"
  },
  "author": "inherent.design",
  "license": "Apache-2.0",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": "^24.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/ts-plugin": "^1.10.12",
    "@cloudflare/vitest-plugin": "^1.3.6",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.1",
    "@vitest/runner": "^4.1.11",
    "@vitest/snapshot": "^4.1.11",
    "eslint": "^10.12.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-cflint": "^1.0.0",
    "globals": "^17.13.0",
    "jiti": "^2.7.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.147.0"
  },
  "dependencies": {
    "@inherent.design/brand": "^0.4.1",
    "@tabler/icons": "^3.48.0",
    "@tailwindcss/forms": "^0.5.11",
    "animejs": "4.5.0",
    "astro": "7.3.5",
    "hono": "^4.13.12",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tw-animate-css": "^1.4.0"
  }
}
